# Resend (server-side)
RESEND_API_KEY=re_xxxxxxxxx

# Where contact form emails are delivered (comma/semicolon separated supported)
# Example: first@company.com, second@company.com
CONTACT_TO_EMAIL=you@example.com

# Sender address (must be verified in Resend for production sending)
CONTACT_FROM_EMAIL="Sapiens AeroComp <onboarding@resend.dev>"

# Public site URL used for metadata/canonical/sitemap/JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.sapiensaerocomp.com

# Optional webmaster verification values
GOOGLE_SITE_VERIFICATION=your_google_verification_token
BING_SITE_VERIFICATION=your_bing_verification_token

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19

# Server-only token used to save contact submissions. Never expose this as NEXT_PUBLIC_*.
SANITY_API_WRITE_TOKEN=sk_xxxxxxxxx
